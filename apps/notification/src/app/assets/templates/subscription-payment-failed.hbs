<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Subscription Payment Failed</title>
</head>

<body style="margin:0; padding:0; background:#f4f6f8; font-family:Arial, Helvetica, sans-serif;">

  <table align="center" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center">

        <table width="600" cellpadding="0" cellspacing="0" style="background:white; padding:40px; border-radius:8px;">

          <!-- Logo -->
          <tr>
            <td align="center" style="padding-bottom:20px;">
              <img src="cid:logo" alt="MedicPadi Logo" width="80" />
            </td>
          </tr>

          <!-- Title -->
          <tr>
            <td align="center">
              <h2 style="margin:0; color:#222;">Subscription Payment Failed</h2>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding-top:20px; color:#555; font-size:15px; line-height:1.6;">
              Hi {{name}},
              <br /><br />
              We were unable to collect payment for your <strong>{{planName}}</strong> plan (attempt {{attempt}} of {{maxAttempts}}).
              <br /><br />
              <table width="100%" cellpadding="0" cellspacing="0"
                     style="background:#fef2f2; border-radius:6px; border-left:4px solid #dc2626;">
                <tr>
                  <td style="padding:16px 20px; font-size:14px; color:#333; line-height:1.8;">
                    <strong>Plan:</strong> {{planName}}<br />
                    <strong>Amount:</strong> {{currency}} {{amount}}{{#if reason}}<br />
                    <strong>Reason:</strong> {{reason}}{{/if}}<br />
                    <strong>Keep your plan by:</strong> {{graceUntil}}
                  </td>
                </tr>
              </table>
              <br />
              We will try again tomorrow. If payment still fails by {{graceUntil}}, your account will move to the Free plan. To avoid losing access, please update your card or resubscribe from your dashboard.
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td align="center" style="padding-top:30px;">
              <a href="{{websiteUrl}}"
                 style="background:rgb(68,18,203); color:white; text-decoration:none; padding:12px 24px; border-radius:6px; font-weight:bold;">
                Manage Subscription
              </a>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding-top:40px; font-size:12px; color:#888; text-align:center;">
              © {{year}} MedicPadi. All rights reserved.
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
