<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Health Records Access Request</title>
</head>

<body style="margin:0; padding:0; background:#f4f6f8; font-family:Arial, Helvetica, sans-serif;">

  <table align="center" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center">

        <table width="600" cellpadding="0" cellspacing="0" style="background:white; padding:40px; border-radius:8px;">

          <!-- Logo -->
          <tr>
            <td align="center" style="padding-bottom:20px;">
              <img src="cid:logo" alt="MedicPadi Logo" width="80" />
            </td>
          </tr>

          <!-- Title -->
          <tr>
            <td align="center">
              <h2 style="margin:0; color:#222;">Health Records Access Request</h2>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding-top:20px; color:#555; font-size:15px; line-height:1.6;">
              Hi {{patientName}},
              <br /><br />
              <strong>{{doctorName}}</strong> has requested access to your electronic health records on MedicPadi.
              <br /><br />
              <table width="100%" cellpadding="0" cellspacing="0"
                     style="background:#f8f4ff; border-radius:6px; border-left:4px solid rgb(68,18,203);">
                <tr>
                  <td style="padding:12px 16px; font-size:14px; color:#333;">
                    <strong>Requested by:</strong> {{doctorName}}<br />
                    <strong>Access level:</strong> {{accessLevel}}
                    {{#if message}}<br /><strong>Message:</strong> {{message}}{{/if}}
                  </td>
                </tr>
              </table>
              <br />
              Your records will only be shared if you approve this request. You can revoke access at any time.
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td align="center" style="padding-top:30px;">
              <a href="{{reviewLink}}"
                 style="background:rgb(68,18,203); color:white; text-decoration:none; padding:12px 24px; border-radius:6px; font-weight:bold;">
                Review Request
              </a>
            </td>
          </tr>

          <!-- Disclaimer -->
          <tr>
            <td style="padding-top:24px; font-size:13px; color:#555; line-height:1.6;">
              If you do not recognise this provider, decline the request and contact our support team.
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding-top:40px; font-size:12px; color:#888; text-align:center;">
              © {{year}} MedicPadi. All rights reserved.
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
