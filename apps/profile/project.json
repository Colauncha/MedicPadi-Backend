{
  "name": "profile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/profile/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/profile"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        },
        "staging": {
          "args": ["--node-env=staging"]
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/profile/package.json",
        "{workspaceRoot}/dist/apps/profile/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/profile/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "profile:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "profile:build:development"
        },
        "production": {
          "buildTarget": "profile:build:production"
        },
        "staging": {
          "buildTarget": "profile:build:staging"
        }
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f apps/{projectName}/Dockerfile -t colauncha/medicpadi-{projectName}:latest ."
      }
    },
    "migration:generate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "TS_NODE_PROJECT=apps/profile/tsconfig.app.json ts-node -r ./scripts/register-ts-paths.js ./node_modules/typeorm/cli.js migration:generate apps/profile/src/database/migrations/{args.name} -d apps/profile/data-source.ts --pretty",
          {
            "command": "node scripts/sync-migration-index.mjs apps/profile",
            "forwardAllArgs": false
          },
          {
            "command": "prettier --write apps/profile/src/database/migrations",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "migration:sync-index": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node scripts/sync-migration-index.mjs apps/profile",
          "prettier --write apps/profile/src/database/migrations/index.ts"
        ],
        "parallel": false
      }
    },
    "migration:show": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/profile/tsconfig.app.json ts-node -r ./scripts/register-ts-paths.js ./node_modules/typeorm/cli.js migration:show -d apps/profile/data-source.ts"
      }
    },
    "migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/profile/tsconfig.app.json ts-node -r ./scripts/register-ts-paths.js ./node_modules/typeorm/cli.js migration:run -d apps/profile/data-source.ts"
      }
    },
    "migration:run:fake": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/profile/tsconfig.app.json ts-node -r ./scripts/register-ts-paths.js ./node_modules/typeorm/cli.js migration:run -d apps/profile/data-source.ts --fake"
      }
    },
    "migration:revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/profile/tsconfig.app.json ts-node -r ./scripts/register-ts-paths.js ./node_modules/typeorm/cli.js migration:revert -d apps/profile/data-source.ts"
      }
    },
    "migration:revert:fake": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/profile/tsconfig.app.json ts-node -r ./scripts/register-ts-paths.js ./node_modules/typeorm/cli.js migration:revert -d apps/profile/data-source.ts --fake"
      }
    }
  },
  "tags": [],
  "externalDependencies": ["pg", "tslib"]
}
