{
  "name": "ehr",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ehr/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/ehr"
      },
      "configurations": {
        "development": { "args": ["--node-env=development"] },
        "staging": { "args": ["--node-env=staging"] }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/ehr/package.json",
        "{workspaceRoot}/dist/apps/ehr/package-lock.json"
      ],
      "options": { "buildTarget": "build" }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/ehr/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": { "buildTarget": "build" }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "ehr:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": { "buildTarget": "ehr:build:development" },
        "production": { "buildTarget": "ehr:build:production" },
        "staging": { "buildTarget": "ehr:build:staging" }
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f apps/{projectName}/Dockerfile -t colauncha/medicpadi-{projectName}:latest ."
      }
    },
    "migration:generate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "TS_NODE_PROJECT=apps/ehr/tsconfig.app.json ts-node -r ./scripts/register-ts-paths.js ./node_modules/typeorm/cli.js migration:generate apps/ehr/src/database/migrations/{args.name} -d apps/ehr/data-source.ts --pretty",
          {
            "command": "node scripts/sync-migration-index.mjs apps/ehr",
            "forwardAllArgs": false
          },
          {
            "command": "prettier --write apps/ehr/src/database/migrations",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "migration:sync-index": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node scripts/sync-migration-index.mjs apps/ehr",
          "prettier --write apps/ehr/src/database/migrations/index.ts"
        ],
        "parallel": false
      }
    },
    "migration:show": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/ehr/tsconfig.app.json ts-node -r ./scripts/register-ts-paths.js ./node_modules/typeorm/cli.js migration:show -d apps/ehr/data-source.ts"
      }
    },
    "migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/ehr/tsconfig.app.json ts-node -r ./scripts/register-ts-paths.js ./node_modules/typeorm/cli.js migration:run -d apps/ehr/data-source.ts"
      }
    },
    "migration:run:fake": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/ehr/tsconfig.app.json ts-node -r ./scripts/register-ts-paths.js ./node_modules/typeorm/cli.js migration:run -d apps/ehr/data-source.ts --fake"
      }
    },
    "migration:revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/ehr/tsconfig.app.json ts-node -r ./scripts/register-ts-paths.js ./node_modules/typeorm/cli.js migration:revert -d apps/ehr/data-source.ts"
      }
    },
    "migration:revert:fake": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/ehr/tsconfig.app.json ts-node -r ./scripts/register-ts-paths.js ./node_modules/typeorm/cli.js migration:revert -d apps/ehr/data-source.ts --fake"
      }
    }
  },
  "tags": []
}